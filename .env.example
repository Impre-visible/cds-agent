# Variables lues par buildConfig() (src/config.ts). Chaque groupe reprend,
# dans l'ordre, ce que le code lit réellement — nom exact, défaut appliqué en
# son absence, et bornes de validation quand il y en a. Une variable absente
# ou vide retombe sur son défaut ; une valeur hors bornes ou mal formée fait
# échouer le daemon au démarrage avec un message qui la nomme explicitement.
#
# Copiez ce fichier en .env et éditez-le. .env n'est jamais versionné (voir
# .gitignore) : n'y mettez le vrai token qu'en local.

# ---------------------------------------------------------------------------
# GitLab — connexion et identité du bot
# ---------------------------------------------------------------------------

# Instance GitLab visée. Les "/" de fin sont retirés automatiquement.
# Défaut : https://gitlab.com
GITLAB_URL=https://gitlab.com

# Token d'accès personnel (PAT) du compte bot. OBLIGATOIRE — le daemon
# refuse de démarrer sans lui ("Variable d'environnement manquante").
# Scope minimal : api (lecture/écriture des to-dos, notes, discussions,
# branches). Le token n'est jamais écrit sur disque (voir gitCredentialEnv()
# dans src/config.ts) et n'est transmis à aucun processus enfant non fiable
# (voir sanitizedEnv()).
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Nom d'utilisateur exact du compte propriétaire du PAT ci-dessus.
# OBLIGATOIRE. Le daemon vérifie au démarrage (gitlab.currentUser()) que le
# PAT appartient bien à ce compte, et refuse de démarrer sinon.
BOT_USERNAME=nom-du-compte-bot

# ---------------------------------------------------------------------------
# Polling
# ---------------------------------------------------------------------------

# Intervalle entre deux cycles de polling, en millisecondes.
# Défaut : 30000 (30 s). Bornes : [1000, 3600000] (1 s à 1 h) — en dessous on
# martèle l'API GitLab, au-delà le polling ne sert plus à rien.
POLL_INTERVAL_MS=30000

# Fenêtre de rattrapage des to-dos GitLab passés "done", en MINUTES (pas en
# ms). Défaut : 10. Bornes : [1, 1440] (1 min à 24 h).
# Le filtre s'applique sur l'updated_at du to-do, donc bien sur le moment où
# il est passé "done" — voir docs/adr/0001-polling-plutot-que-webhook.md.
LOOKBACK_MINUTES=10

# Nombre de tentatives avant abandon d'un to-do en échec répété (compteur
# par cycle de vie du process, remis à zéro à chaque redémarrage).
# Défaut : 3. Bornes : [1, 20].
MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Autorisation, capacités, commandes et image par dépôt — projects.json
# ---------------------------------------------------------------------------
#
# Chantier "projects.json" : la liste des dépôts et auteurs autorisés
# (ALLOWED_PROJECTS/ALLOWED_USERS), les capacités de l'agent
# (AGENT_CAPABILITIES), les commandes et l'image Docker par dépôt
# (TEST_COMMANDS/INSTALL_COMMANDS/DOCKER_IMAGES) et les répertoires de test
# maison (TEST_DIRECTORY_OVERRIDES) ne sont PLUS des variables d'environnement
# — elles vivent désormais dans un fichier JSON versionné, relu par des
# humains (voir projects.example.json et le README, section "Configuration
# des projets"). Le daemon REFUSE DE DÉMARRER si l'une de ces sept variables
# traîne encore dans l'environnement, avec un message qui dit où elle a migré
# (voir src/config.ts::assertNoLegacyEnvVars) — un .env hérité qui
# n'autoriserait plus rien en silence serait pire que l'échec.
#
# Chemin du fichier de configuration des projets. Défaut : ./projects.json.
# Absent, illisible ou invalide ⇒ le daemon ne démarre pas (fail-closed) ;
# devenu invalide alors que le daemon tourne déjà ⇒ dernière configuration
# valide conservée, erreur journalisée (voir src/projects.ts::ProjectsRegistry).
PROJECTS_FILE=./projects.json

# ---------------------------------------------------------------------------
# État et journal
# ---------------------------------------------------------------------------

# Fichier journal (JSONL append-only) du cycle de vie des demandes.
# Défaut : ./state/processed.jsonl
STATE_FILE=./state/processed.jsonl

# "1" : ne marque jamais un to-do "done" côté GitLab (laisse pending) — utile
# pour rejouer un même to-do en développement. Toute autre valeur (ou
# absence) : comportement normal, le to-do est marqué done. Défaut : absent
# (marque done).
SKIP_MARK_DONE=0

# ---------------------------------------------------------------------------
# Agent LLM — modèle et budget de temps
# ---------------------------------------------------------------------------

# Identifiant de modèle passé à `opencode run --model`, au format
# "fournisseur/modèle" — validé au démarrage (doit contenir un "/" ni au
# début ni à la fin). Dans la config opencode générée à la volée (voir
# src/agent/sandbox.ts), la partie AVANT le premier "/" nomme le fournisseur
# et celle d'APRÈS sert de clé de modèle : les deux suivent donc cette
# variable, y compris quand l'inférence vise un fournisseur distant
# (INFERENCE_UPSTREAM_URL / INFERENCE_API_KEY plus bas).
# Défaut : lmstudio/qwen2.5-coder-7b-instruct-mlx
AGENT_MODEL=lmstudio/qwen2.5-coder-7b-instruct-mlx

# Budget de temps accordé à une exécution de l'agent (opencode), en MINUTES.
# Défaut : 10. Bornes : [1, 240] (4 h max).
AGENT_TIMEOUT_MINUTES=10

# Budget de temps accordé au planificateur, en MINUTES — distinct du budget
# de l'agent exécutant ci-dessus. Le planificateur est un premier appel au
# modèle, bien plus léger : il lit la charte et le contexte pour rédiger un
# petit plan JSON, sans jamais modifier le dépôt. Il n'est appelé que
# lorsque l'intention n'est pas déjà tranchée par une commande explicite
# (@bot review, @bot implement-tests) ou par le repli par mots-clés — lui
# donner le même plafond que l'agent retarderait ces demandes pour rien.
# Défaut : 3. Bornes : [1, 60].
PLANNER_TIMEOUT_MINUTES=3

# Nombre maximal de remarques que l'on DEMANDE au modèle de produire (dans le
# prompt). Distinct du plafond de PUBLICATION ci-dessous : le modèle doit
# chercher large, c'est la MR qui reste courte.
#
# Mesuré sur la MR !5 : à 5, les trois modèles testés ont rendu exactement 5
# remarques — le plafond était donc contraignant à chaque fois. À 12,
# gpt-oss-120b en a rendu 6, dont `sortTodos` appliqué après le découpage en
# pages : le seul modèle de toute la campagne à avoir trouvé ce défaut, et il
# était coupé. Ce que le plafond retranchait n'était pas du bruit.
# Défaut : 12. Bornes : [1, 50].
REVIEW_BUDGET=12

# Sévérité MINIMALE publiée dans la MR. C'est le mécanisme de SÉLECTION :
# on filtre par nature du défaut, pas par quantité.
#
# Mesuré sur la MR !5 (3 passes en mode exclusion, 15 remarques distinctes) :
# les cinq "error" étaient tous justes, et les trois faux positifs
# identifiables étaient tous des "info". Trancher sur un nombre coupait deux
# défauts réels et difficiles ; trancher sur la gravité publie les dix
# remarques recevables et écarte les trois faux positifs.
#
#   warning  (défaut) publie error + warning, écarte info
#   info     publie tout, aucun filtre
#   error    ne publie que les défauts affirmés
#
# Ce que ce seuil écarte n'est jamais perdu : `npm run review` l'affiche dans
# une section à part, et le daemon le journalise. Seuls ces trois mots sont
# acceptés (les synonymes que rend le modèle — "bug", "minor"... — sont
# traduits en amont, mais pas acceptés ici).
MIN_SEVERITY=warning

# Nombre maximal de remarques PUBLIÉES. Depuis que MIN_SEVERITY sélectionne,
# ce n'est plus qu'une BORNE DE VOLUME : un garde-fou contre un emballement
# (un modèle qui rendrait cinquante remarques), jamais l'arbitre entre deux
# remarques recevables. Le défaut est volontairement au-dessus de ce qu'une
# revue produit en pratique — 15 remarques distinctes sur le pire run mesuré.
#
# Volontairement NON plafonné par REVIEW_BUDGET : avec N passes, l'union peut
# légitimement dépasser ce qu'une seule passe pouvait rendre (15 distinctes
# mesurées pour un budget de 12 par passe).
# Défaut : 15. Bornes : [1, 50] — 0 viderait silencieusement toute review.
MAX_REMARKS=15

# Nombre de passes de revue sur le même diff. Selon l'agrégation retenue (voir
# REVIEW_VOTE), seules les remarques apparues dans une MAJORITÉ STRICTE de
# passes réussies sont conservées (2 passes → il faut les 2 ; 3 → il en faut
# 2 ; 4 → 3), ou bien toutes sont réunies et dédupliquées.
#
# Défaut 1 : une seule passe, comportement inchangé. Au-delà, c'est la seule
# réponse structurelle au non-déterminisme des modèles — mesuré : deux runs
# de qwen3-235b-a22b, même prompt, six secondes d'écart, 5 remarques puis 1.
# Ce n'est pas propre aux petits modèles : c'est constaté à 235 milliards de
# paramètres. Un faux positif non reproductible ne survit pas au vote.
# Coût : N fois le temps et les tokens, linéairement.
# Défaut : 1. Bornes : [1, 7].
REVIEW_PASSES=1

# Stratégie de construction du prompt des passes ≥ 2 (sans effet à
# REVIEW_PASSES=1). BANC D'ESSAI : ce réglage existe pour rendre trois
# stratégies comparables sur un même jeu de bugs, pas pour en imposer une.
#
#   independent  chaque passe part du même prompt, sans rien savoir des
#                précédentes. Défaut. C'est ce qui a produit les meilleurs
#                résultats mesurés (MR !2, trois tirages indépendants de
#                qwen3.6-35b-a3b : 3, 4 puis 4 défauts sur 5, ensembles
#                DIFFÉRENTS, union 4/5 — une passe seule n'a jamais dépassé 4).
#   chained      la passe N reçoit les remarques précédentes comme un contexte
#                à confirmer, corriger ou approfondir.
#   exclusion    la passe N reçoit les remarques précédentes comme une liste de
#                ce qui est DÉJÀ couvert, avec la consigne de chercher ailleurs.
#
# Le risque que la mesure doit trancher : montrer du travail déjà fait à un
# modèle tend à le faire vérifier au lieu de chercher — déjà observé ici
# (qwen3.5-397b a lu le dépôt, constaté que les tests demandés existaient, et
# rendu `no-change`). `chained` et `exclusion` peuvent donc RÉDUIRE
# l'exploration. Rien ne préjuge du résultat : c'est la campagne qui décide.
REVIEW_PASS_MODE=independent

# Agrégation des passes : vote majoritaire (défaut) ou simple union
# dédupliquée. "0" bascule sur l'union.
#
# Attention : `chained` et `exclusion` FORCENT l'union quoi qu'il arrive. Ces
# modes demandent à la passe N de ne pas répéter les précédentes, donc aucune
# remarque n'y obtient deux voix — un vote majoritaire y publierait zéro
# remarque à tous les coups. Ce drapeau ne décide réellement que du mode
# `independent`. Pour comparer les trois modes sans mélanger deux variables,
# mettre REVIEW_VOTE=0 partout.
REVIEW_VOTE=1

# Relecture croisée après une implémentation livrée : un second passage du
# modèle, EN LECTURE SEULE, relit les tests poussés contre le code source
# qu'ils importent, et ses constats partent dans le rapport comme points à
# vérifier — jamais bloquant. C'est la seule réponse à l'angle mort mesuré :
# un test VERT qui épouse un défaut au lieu de le révéler (valeur d'entrée
# choisie pour esquiver le bug, frontière jamais testée, assertion qui ne
# peut pas échouer). Coût : un appel de modèle par implémentation livrée.
# "0" pour couper. Défaut : activée.
CHAINED_REVIEW=1

# Bras témoin des campagnes de mesure : "0" retire le bloc « Conventions de
# test » du prompt d'implémentation, pour mesurer un même jeu de bugs AVEC et
# SANS les conventions. Ne sert à rien en exploitation normale — laisser à 1.
PROMPT_TEST_CONVENTIONS=1

# ---------------------------------------------------------------------------
# Git — identité des commits créés par le daemon
# ---------------------------------------------------------------------------

# Défaut : cds-agent
GIT_AUTHOR_NAME=cds-agent

# Défaut : cds-agent@local.invalid
GIT_AUTHOR_EMAIL=cds-agent@local.invalid

# ---------------------------------------------------------------------------
# Commandes exécutées dans le dépôt cible
# ---------------------------------------------------------------------------

# Commande d'installation des dépendances du dépôt cible.
# Défaut : npm install
INSTALL_COMMAND=npm install

# Commande de test du dépôt cible (relancée par le daemon lui-même après
# l'exécution de l'agent — jamais sur la seule foi de ce que l'agent
# prétend avoir vérifié).
# Défaut : npm test
TEST_COMMAND=npm test

# INSTALL_COMMAND/TEST_COMMAND ci-dessus restent le défaut GLOBAL (n'ont pas
# migré vers projects.json) : le repli ultime quand ni le dépôt ni le bloc
# "defaults" de projects.json ne précisent de commande — voir
# projects.example.json ("commands": {"install", "test"}) pour l'affinage
# par dépôt, qui remplace les anciennes INSTALL_COMMANDS/TEST_COMMANDS.

# "0" : désactive --ignore-scripts sur INSTALL_COMMAND (revient au
# comportement historique : les scripts npm du dépôt cible, notamment
# postinstall, s'exécutent normalement, avec accès réseau). Toute autre
# valeur (ou absence) : --ignore-scripts est ajouté par défaut, pour qu'un
# postinstall hostile ne s'exécute pas avant tout contrôle. À mettre à 0 au
# cas par cas, pour un dépôt qui ne s'installe pas correctement sans ses
# scripts (binaire natif, génération de fichiers...).
# Défaut : absent (scripts ignorés).
INSTALL_IGNORE_SCRIPTS=1

# Profondeur de clone (git clone --depth). Défaut : 20. Minimum : 0 (0 =
# clone complet, pas de limite). Une valeur trop petite n'est pas dangereuse
# pour le contrôle de sécurité : implement.ts approfondit à la demande
# (fetch --unshallow) si merge-base échoue faute d'ancêtre commun local.
CLONE_DEPTH=20

# Timeout appliqué aux commandes courtes (install, tests), en MINUTES —
# distinct du budget de l'agent (AGENT_TIMEOUT_MINUTES) : sans cette
# distinction, c'est ce timeout-ci qui s'appliquerait aussi à l'agent en
# mode Docker. Défaut : 5. Bornes : [1, 60].
COMMAND_TIMEOUT_MINUTES=5

# Chemin d'un script à exécuter À LA PLACE de l'agent réel (utile pour les
# tests d'intégration locaux, voir fixtures/*.sh) — vide par défaut (agent
# réel utilisé). Ne PAS renseigner en usage normal.
FAKE_AGENT_SCRIPT=

# ---------------------------------------------------------------------------
# Sandbox Docker — sécurité par défaut
# ---------------------------------------------------------------------------

# Sandbox Docker activée par défaut, quelle que soit la valeur de USE_DOCKER
# tant qu'elle n'est pas explicitement "0". USE_DOCKER=1 est accepté tel
# quel (aucun changement de comportement) mais n'a pas besoin d'être
# renseigné : la sandbox est déjà le défaut.
#
# USE_DOCKER=0 SEUL NE SUFFIT PLUS À DÉSACTIVER LA SANDBOX : le daemon
# refuse de démarrer ("USE_DOCKER=0 ne suffit plus...") tant que
# ALLOW_UNSANDBOXED=1 n'est pas également présent. C'est volontaire : avant
# ce durcissement, USE_DOCKER=0 suffisait (et était même le défaut) à faire
# tourner l'agent directement sur l'hôte, avec le profil de connexion de
# l'utilisateur qui lance le daemon — un .env hérité avec USE_DOCKER=0 ne
# doit plus rouvrir ce trou silencieusement.
USE_DOCKER=1

# Coupe-circuit explicite et bruyant vers le mode hôte non sandboxé (affiche
# un avertissement au démarrage). "1" désactive Docker : l'agent tourne
# alors directement sur l'hôte via bash -lc (voir runCommand() dans
# src/agent/workspace.ts). RÉSERVÉ AU DÉVELOPPEMENT LOCAL — ne jamais
# activer si le dépôt cible n'est pas totalement digne de confiance.
# Défaut : absent (sandbox active).
ALLOW_UNSANDBOXED=0

# Image Docker par défaut pour l'installation et les tests du dépôt cible —
# défaut GLOBAL (n'a pas migré vers projects.json, contrairement à l'image par
# dépôt : voir projects.example.json, "docker": {"image": "..."}, qui remplace
# l'ancienne DOCKER_IMAGES). Repli ultime quand ni le dépôt ni "defaults" de
# projects.json ne précisent d'image.
# Défaut : node:22-bookworm-slim
DOCKER_DEFAULT_IMAGE=node:22-bookworm-slim

# Image dans laquelle tourne l'agent (opencode) — voir docker/agent.Dockerfile.
# Défaut : cds-agent/agent-node22
AGENT_IMAGE=cds-agent/agent-node22

# Limite mémoire passée à `docker run --memory`. Format validé :
# nombre suivi d'une unité optionnelle b/k/m/g (ex. "4g", "512m").
# Défaut : 4g
DOCKER_MEMORY=4g

# Limite CPU passée à `docker run --cpus`. Format validé : entier ou décimal.
# Défaut : 4
DOCKER_CPUS=4

# Nombre maximal de processus/threads passé à `docker run --pids-limit`.
# Défaut : 512. Bornes : [16, 16384]. Un install ou une suite de tests qui
# lance beaucoup de processus en parallèle (workers de test, watchers...)
# peut légitimement avoir besoin de plus que le défaut.
DOCKER_PIDS_LIMIT=512

# Limite de descripteurs de fichiers passée à `docker run --ulimit
# nofile=soft:hard`. Format validé : deux entiers séparés par ":".
# Défaut : 4096:8192.
DOCKER_ULIMIT_NOFILE=4096:8192

# Taille du tmpfs monté sur /tmp dans le conteneur (`docker run --tmpfs
# /tmp:...,size=...`) — seul répertoire inscriptible avec /repo, le système
# de fichiers racine du conteneur étant en lecture seule. Même format que
# DOCKER_MEMORY. Défaut : 1g.
DOCKER_TMPFS_SIZE=1g

# ---------------------------------------------------------------------------
# Inférence — accès du conteneur agent au serveur de modèle
# ---------------------------------------------------------------------------
# Ces trois variables ne concernent QUE le mode Docker (le seul supporté en
# usage normal) : c'est lui qui génère la config opencode du conteneur. En
# USE_DOCKER=0, opencode tourne sur l'hôte avec la configuration propre de
# l'opérateur, et rien de ce qui suit n'est lu.

# Serveur d'inférence réel, vu depuis l'HÔTE (pas depuis un conteneur).
# Défaut : http://127.0.0.1:1234/v1 (LM Studio par défaut). Une URL https://
# est relayée en HTTPS : c'est ce qui permet de viser un fournisseur distant
# plutôt que l'inférence locale, par exemple
#   INFERENCE_UPSTREAM_URL=https://api.scaleway.ai/v1
# Pensez alors à aligner AGENT_MODEL : son préfixe "fournisseur/" nomme le
# fournisseur déclaré à opencode, et son suffixe doit être l'identifiant de
# modèle attendu par cette API (ex. AGENT_MODEL=scaleway/mistral-nemo-instruct).

# Clé d'API du serveur d'inférence. Absente par défaut : LM Studio en local
# n'en demande aucune. Renseignée, elle est ajoutée en
# "Authorization: Bearer <clé>" PAR LE PROXY de l'hôte au moment de relayer —
# elle n'entre jamais dans le conteneur agent, qui exécute du code écrit par
# le LLM et ne voit que l'adresse du proxy. Elle n'est pas non plus transmise
# aux processus enfants (liste blanche de sanitizedEnv(), src/config.ts).
# Seule exception : CONTAINER_INFERENCE_URL ci-dessous court-circuite le
# proxy, la clé doit alors descendre jusqu'au conteneur pour que l'appel
# aboutisse.
# INFERENCE_API_KEY=xxxxxxxxxxxxxxxxxxxx

# Fenêtre de contexte et budget de sortie déclarés à opencode pour le modèle
# de l'agent. Sans ces valeurs, opencode réclame 32000 tokens de SORTIE par
# défaut sur un fournisseur custom (bug connu, opencode#1735) : tout modèle
# dont le plafond est plus bas refuse alors la requête, quel que soit son
# niveau. Mesuré : gemma-3-27b (8192 max), devstral-2-123b (16384 max) et
# holo2-30b (contexte 22000) éliminés d'une campagne pour cette seule raison.
# Défauts : 128000 / 16000 — tiennent chez les modèles courants. À baisser
# pour un modèle à fenêtre courte, ex. gemma-3-27b : 64000 / 8000.
# Bornes : contexte [1000, 10000000], sortie [256, 1000000].
INFERENCE_CONTEXT_LIMIT=128000
INFERENCE_OUTPUT_LIMIT=16000

# Port d'écoute du proxy d'inférence filtrant démarré par le daemon pour
# chaque exécution de l'agent (relais exclusif vers INFERENCE_UPSTREAM_URL,
# jamais un accès direct du conteneur à host.docker.internal). 0 = l'OS
# choisit un port libre — recommandé, un seul worker tourne à la fois donc
# aucun besoin réel de port fixe. Défaut : 0. Bornes : [0, 65535].
INFERENCE_PROXY_PORT=0

# Échappatoire explicite : si renseignée, court-circuite le proxy filtrant
# et redonne au conteneur un accès direct à cette URL (typiquement
# http://host.docker.internal:1234/v1). Absente par défaut — à réserver à un
# usage avancé conscient d'élargir l'accès réseau du conteneur à tous les
# ports de l'hôte joignables par ce chemin, et de lui confier INFERENCE_API_KEY
# si elle est définie (plus de proxy pour authentifier à sa place).
# CONTAINER_INFERENCE_URL=http://host.docker.internal:1234/v1

# ---------------------------------------------------------------------------
# GitLab — résilience réseau
# ---------------------------------------------------------------------------

# Timeout HTTP appliqué à toute requête GitLab, écritures comprises, en
# MILLISECONDES. Défaut : 20000 (20 s). Bornes : [50, 300000] (le plancher
# bas sert surtout aux tests contre un serveur HTTP local).
GITLAB_REQUEST_TIMEOUT_MS=20000

# Nombre de réessais (en plus de la tentative initiale) pour les requêtes
# idempotentes (GET/HEAD) face à une erreur transitoire (429, 5xx, erreur
# réseau). Ne s'applique jamais aux écritures (POST) : un POST qui timeout
# ne dit pas si GitLab l'a traité avant de cesser de répondre, le réessayer
# pourrait publier deux fois le même commentaire. Défaut : 4. Bornes : [0, 10]
# (0 désactive les réessais sans désactiver le timeout ci-dessus).
GITLAB_MAX_RETRIES=4

# Délai de base du backoff exponentiel à jitter complet entre deux
# tentatives, en MILLISECONDES. Défaut : 500. Bornes : [1, 60000].
GITLAB_RETRY_BASE_MS=500

# Plafond du délai entre deux tentatives, en MILLISECONDES — évite qu'un 429
# mal réglé ne fasse attendre le worker des minutes entières.
# Défaut : 8000. Bornes : [1, 120000].
GITLAB_RETRY_MAX_DELAY_MS=8000

# ---------------------------------------------------------------------------
# Proxy d'entreprise (§A/§B) — HTTP_PROXY / HTTPS_PROXY / NO_PROXY
# ---------------------------------------------------------------------------
#
# HTTP_PROXY / HTTPS_PROXY / NO_PROXY (variantes minuscules également
# reconnues) NE PASSENT PAS par buildConfig() — lues directement depuis
# process.env, à chaque requête, par src/gitlab/proxy-fetch.ts et
# src/config.ts::containerProxyEnv() (même raison que LOG_LEVEL/LOG_PRETTY,
# voir plus bas). Absentes de ce fichier comme variables à valeur par
# défaut : ce sont des conventions déjà universelles (curl, git, la plupart
# des outils réseau), pas des réglages propres à ce projet — mais leur RÔLE
# ICI mérite d'être documenté, précisément parce qu'il est nouveau :
#
# - src/gitlab/client.ts (appels API GitLab, via fetch()) : Node n'honore
#   AUCUNE de ces variables nativement pour fetch() (contrairement à git, qui
#   lit son propre http.<url>.proxy depuis ~/.gitconfig) — vérifié
#   empiriquement, y compris le mécanisme --use-env-proxy/NODE_USE_ENV_PROXY
#   de Node 22.21+/24.5+, qui s'est révélé sans effet sur fetch() dans cet
#   environnement (voir le rapport de la tâche). gitlab/proxy-fetch.ts
#   réimplémente donc lui-même, sur node:http/node:https/node:tls, le
#   nécessaire pour honorer ces variables — indépendamment de tout flag Node.
# - Conteneur d'installation/tests du dépôt cible (implement.ts, network:
#   true UNIQUEMENT) : transmises via containerProxyEnv() (src/config.ts),
#   avec réécriture automatique vers host.docker.internal si le proxy écoute
#   sur le loopback de l'hôte (127.0.0.1/localhost — injoignable tel quel
#   depuis le netns du conteneur). PAS transmises quand le réseau est coupé
#   (network: false), ni au conteneur agent (network: true mais restreint
#   volontairement au seul proxy d'inférence local — voir INFERENCE_* plus
#   haut ; y ajouter le proxy d'entreprise élargirait sa portée réseau, à
#   l'exact opposé de cette restriction).
#
# Si votre proxy n'est configuré QUE dans ~/.gitconfig (http.<url>.proxy) et
# jamais exporté comme variable d'environnement, git en profite déjà mais PAS
# les deux usages ci-dessus : le daemon avertit au démarrage dans ce cas
# précis (voir src/daemon/proxy-check.ts), sans jamais journaliser la valeur
# du proxy configuré (peut embarquer un identifiant, ex.
# http://utilisateur:jeton@proxy:8080 — vu en pratique).
# HTTP_PROXY=http://utilisateur:motdepasse@proxy.corp.example:3128
# HTTPS_PROXY=http://utilisateur:motdepasse@proxy.corp.example:3128
# NO_PROXY=localhost,127.0.0.1,.corp.example

# Échappatoires explicites pour le conteneur d'installation/tests
# uniquement : si renseignées, court-circuitent ENTIÈREMENT HTTP_PROXY/
# HTTPS_PROXY/NO_PROXY de l'hôte ET la réécriture automatique loopback →
# host.docker.internal ci-dessus — à réserver au cas où cette réécriture ne
# convient pas (un alias réseau propre à l'hôte, ni loopback ni une adresse
# LAN normale, par exemple). Absentes par défaut. Ne concernent jamais le
# conteneur agent (voir plus haut).
# CONTAINER_HTTP_PROXY=http://host.docker.internal:3128
# CONTAINER_HTTPS_PROXY=http://host.docker.internal:3128
# CONTAINER_NO_PROXY=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Environnement des processus enfants non fiables
# ---------------------------------------------------------------------------

# Noms de variables d'environnement supplémentaires à transmettre aux
# processus enfants non fiables (git, agent, bash -lc en mode non
# sandboxé), en plus de la liste blanche de base (PATH, HOME, LANG,
# LANGUAGE, TERM, TMPDIR/TMP/TEMP, *_PROXY, et le préfixe LC_). Séparés par
# des virgules, SENSIBLE À LA CASSE (ce sont des noms de variables
# d'environnement). Vide par défaut. N'ajoute jamais rien retirer de la
# liste de base ; ne JAMAIS y placer une variable portant un secret (elle
# serait alors transmise telle quelle à du code potentiellement écrit par
# le LLM).
# SANITIZED_ENV_EXTRA_KEYS=MY_CORP_PROXY

# ---------------------------------------------------------------------------
# Journalisation
# ---------------------------------------------------------------------------

# Niveau minimal des lignes émises : debug, info, warn ou error. Toute autre
# valeur (ou absence) retombe sur "info". Défaut : info.
LOG_LEVEL=info

# "1" : sortie condensée lisible par un humain (une ligne par événement,
# horodatage court, clé de corrélation entre crochets) au lieu du JSON par
# ligne par défaut. Le JSON reste le format à utiliser dès qu'un outil (pas
# un humain) lit ces logs. Défaut : absent (JSON).
LOG_PRETTY=0

# ---------------------------------------------------------------------------
# Observabilité — serveur HTTP /healthz + /metrics
# ---------------------------------------------------------------------------

# "0" désactive complètement le serveur d'observabilité (aucun port n'est
# alors ouvert). Toute autre valeur (ou absence) : activé. Défaut : activé.
HEALTH_ENABLED=1

# Port d'écoute du serveur /healthz + /metrics. 0 = l'OS choisit un port
# libre. Défaut : 8090. Bornes : [0, 65535].
HEALTH_PORT=8090

# Adresse d'écoute du serveur d'observabilité. Défaut : 127.0.0.1 (loopback
# uniquement) — à élargir explicitement (ex. 0.0.0.0) si un système de
# supervision externe doit pouvoir le joindre depuis une autre machine.
HEALTH_HOST=127.0.0.1
